# Required Kimi credentials. Replace these placeholders locally; never commit real secrets.
KIMI_API_KEY=replace-with-your-kimi-api-key
KIMI_MODEL=replace-with-your-kimi-model
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Local SQLite persistence.
DATABASE_URL=sqlite:///./agent_harness.db

# Model and tool execution budgets.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_RETRIES=2
RETRY_BACKOFF_BASE_SECONDS=0.5
RETRY_BACKOFF_MAX_SECONDS=8
AGENT_MAX_STEPS=20
AGENT_ACTIVE_TIME_LIMIT_SECONDS=120

# Context compaction and response validation controls.
CONTEXT_WINDOW_ROUNDS=15
CONTEXT_COMPACT_ROUNDS=10
MALFORMED_RESPONSE_LIMIT=2
TOOL_RESULT_MAX_BYTES=16384

# Multi-turn conversation limits.
CONVERSATION_WINDOW_TURNS=12
CONVERSATION_COMPACT_TURNS=8
CONVERSATION_MAX_TURNS=50

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
